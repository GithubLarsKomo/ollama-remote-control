# Ollama Remote Control local Compose configuration
# Copy this file to .env and adjust values for the deployment host.

# Container image/build identity
ORC_IMAGE=ollama-remote-control:local

# Host-side bind address and published port
ORC_BIND_ADDRESS=127.0.0.1
ORC_PORT=3000

# Browser session transport security
# true  = default and required for normal/production use behind HTTPS
# false = explicit exception for trusted local/loopback HTTP beta testing only
ORC_SECURE_COOKIES=true

# Optional alternative host-side master-key secret path
# ORC_MASTER_KEY_SECRET_FILE=./secrets/orc_master_key
